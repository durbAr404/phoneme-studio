ENV=development
RELEASE=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/phonemestudio

COOKIE_SECURE=false           # true in production (HTTPS)
ALLOWED_ORIGINS=http://localhost:3000
IP_HASH_SALT=change-me
REDIS_URL=                    # optional: Upstash Redis URL when running more than one API instance

# Observability and operations
SENTRY_DSN=
LOG_LEVEL=INFO
CRON_SECRET=change-me
ALERT_WEBHOOK_URL=

# Only used when the optional showcase folder (app/showcase) is present:
# sign-in, the admin dashboard, teacher accounts and the read-only demos.
AUTH_ENABLED=false            # real Google sign-in; keep false on the public site
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=you@example.com
DEV_LOGIN_ENABLED=true        # local only; refused when ENV=production
DEMO_ENABLED=true
